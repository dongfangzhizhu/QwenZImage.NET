<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately NOT part of QwenZImage.NET.sln and deliberately NOT a
       ProjectReference: this project must compile against the exact bits that
       nuget.org serves. Point the config / QwenZImage.config.json at local
       weights and the native switch at a locally built CUDA QwenZImageNative. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PublishedPackageSmokeTest</AssemblyName>
    <RootNamespace>PublishedPackageSmokeTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QwenZImage.NET" Version="0.3.0" />
  </ItemGroup>

</Project>
