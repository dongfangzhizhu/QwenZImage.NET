<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>QwenZImage.NET.PackageVerification</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Deliberately a PackageReference only: a ProjectReference would verify
         the local sources instead of the package published to nuget.org. -->
    <PackageReference Include="QwenZImage.NET" Version="0.1.0" />
  </ItemGroup>

</Project>
